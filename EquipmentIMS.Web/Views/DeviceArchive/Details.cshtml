@model EquipmentIMS.Models.DTOs.DeviceArchiveDto
@{
    ViewData["Title"] = "设备档案详情";
    var repairOrders = ViewData["RepairOrders"] as List<EquipmentIMS.Models.DTOs.RepairOrderDto>;
    var isInWarranty = Model.WarrantyEnd.HasValue && Model.WarrantyEnd.Value >= DateTime.Today;
}

<div class="content-card" style="max-width:960px">
    <div class="content-header">
        <h4>@ViewData["Title"]</h4>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>编辑</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-1"><i class="bi bi-arrow-left me-1"></i>返回</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-info-circle me-1"></i>基本信息
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered mb-0">
                        <tr><td class="bg-light fw-bold" style="width:120px">序列号</td><td><span class="fw-medium">@Model.SerialNo</span></td></tr>
                        <tr><td class="bg-light fw-bold">设备产品</td><td>@Model.ProductCode - @Model.ProductName</td></tr>
                        <tr><td class="bg-light fw-bold">状态</td>
                            <td>
                                @if (Model.Status == 1)
                                {
                                    <span class="badge bg-success">@Model.StatusName</span>
                                }
                                else if (Model.Status == 2)
                                {
                                    <span class="badge bg-warning text-dark">@Model.StatusName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Model.StatusName</span>
                                }
                            </td>
                        </tr>
                        <tr><td class="bg-light fw-bold">安装日期</td><td>@(Model.InstallDate?.ToString("yyyy-MM-dd") ?? "-")</td></tr>
                        <tr><td class="bg-light fw-bold">备注</td><td>@(Model.Remark ?? "-")</td></tr>
                        <tr><td class="bg-light fw-bold">创建时间</td><td>@Model.CreateTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-building me-1"></i>客户信息
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered mb-0">
                        <tr><td class="bg-light fw-bold" style="width:120px">客户名称</td><td>@Model.CustomerName</td></tr>
                        <tr><td class="bg-light fw-bold">关联订单</td><td>@(Model.SaleOrderId.HasValue ? Model.SaleOrderId.ToString() : "-")</td></tr>
                    </table>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-shield-check me-1"></i>保修信息
                    @if (isInWarranty)
                    {
                        <span class="badge bg-success ms-2">保修期内</span>
                    }
                    else if (Model.WarrantyEnd.HasValue)
                    {
                        <span class="badge bg-danger ms-2">已过保</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">无保修</span>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered mb-0">
                        <tr><td class="bg-light fw-bold" style="width:120px">保修开始</td><td>@(Model.WarrantyStart?.ToString("yyyy-MM-dd") ?? "-")</td></tr>
                        <tr><td class="bg-light fw-bold">保修截止</td><td>@(Model.WarrantyEnd?.ToString("yyyy-MM-dd") ?? "-")</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-light fw-bold">
            <i class="bi bi-tools me-1"></i>历史维修工单
            <span class="badge bg-primary ms-2">@(repairOrders?.Count ?? 0) 条</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>工单号</th>
                            <th>故障描述</th>
                            <th>状态</th>
                            <th>技术员</th>
                            <th>是否保修</th>
                            <th>费用</th>
                            <th>完成时间</th>
                            <th>创建时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (repairOrders == null || !repairOrders.Any())
                        {
                            <tr><td colspan="8" class="text-center text-muted py-3">暂无维修记录</td></tr>
                        }
                        else
                        {
                            @foreach (var ro in repairOrders)
                            {
                                <tr>
                                    <td><span class="fw-medium">@ro.OrderNo</span></td>
                                    <td style="max-width:200px" class="text-truncate" title="@ro.FaultDesc">@ro.FaultDesc</td>
                                    <td>
                                        @{
                                            var roBadge = ro.Status switch
                                            {
                                                0 or 1 or 2 => "bg-warning text-dark",
                                                3 => "bg-info",
                                                4 or 5 => "bg-success",
                                                6 => "bg-secondary",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @roBadge">@ro.StatusName</span>
                                    </td>
                                    <td>@(ro.TechnicianName ?? "-")</td>
                                    <td>@(ro.IsWarranty ? "是" : "否")</td>
                                    <td>@ro.TotalCost.ToString("F2")</td>
                                    <td>@(ro.CompleteTime?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>@ro.CreateTime.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
