@model List<EquipmentIMS.Models.DTOs.CustomerPriceDto>
@{
    ViewData["Title"] = "客户专属价格";
    var customerId = (long)ViewBag.CustomerId;
    var customerName = ViewBag.CustomerName as string;
}

<div class="content-card">
    <div class="content-header">
        <h4><i class="bi bi-tag me-2"></i>客户专属价格 - @customerName</h4>
        <div>
            <button class="btn btn-primary btn-sm" onclick="showAddModal()"><i class="bi bi-plus-lg me-1"></i>新增价格</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-2"><i class="bi bi-arrow-left me-1"></i>返回</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table data-table">
            <thead><tr>
                <th>设备编码</th><th>设备名称</th><th>规格型号</th><th>销售价</th><th>生效日期</th><th>失效日期</th><th>备注</th><th style="width:100px">操作</th>
            </tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无专属价格</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td>@item.Spec</td>
                        <td>@item.SalePrice.ToString("N2")</td>
                        <td>@item.EffectiveDate.ToString("yyyy-MM-dd")</td>
                        <td>@(item.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@item.Remark</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" onclick="deletePrice(@item.Id)" title="删除"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="priceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">设置专属价格</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="customerId" value="@customerId" />
                <div class="mb-3">
                    <label class="form-label">设备</label>
                    <select id="productId" class="form-select" style="width:100%">
                        <option value="">请选择设备</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">销售价</label>
                    <input id="salePrice" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">生效日期</label>
                        <input id="effectiveDate" class="form-control" type="date" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">失效日期</label>
                        <input id="expiryDate" class="form-control" type="date" />
                    </div>
                </div>
                <div class="mt-3">
                    <label class="form-label">备注</label>
                    <textarea id="remark" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="savePrice()">保存</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var priceModal;
        $(function () {
            priceModal = new bootstrap.Modal('#priceModal');
            $.get('/Product/GetProductsJson', function (res) {
                if (res.success && res.data) {
                    res.data.forEach(function (p) {
                        $('#productId').append('<option value="' + p.id + '">' + p.code + ' ' + p.name + '</option>');
                    });
                }
            });
        });

        function showAddModal() {
            $('#productId').val('');
            $('#salePrice').val('');
            $('#effectiveDate').val(new Date().toISOString().split('T')[0]);
            $('#expiryDate').val('');
            $('#remark').val('');
            priceModal.show();
        }

        function savePrice() {
            var data = {
                customerId: @customerId,
                productId: parseInt($('#productId').val()) || 0,
                salePrice: parseFloat($('#salePrice').val()) || 0,
                effectiveDate: $('#effectiveDate').val(),
                expiryDate: $('#expiryDate').val() || null,
                remark: $('#remark').val()
            };
            if (!data.productId) { showError('请选择设备'); return; }
            if (data.salePrice <= 0) { showError('销售价必须大于0'); return; }

            ajaxPost('/Customer/SetPrice', data, function () {
                priceModal.hide();
                location.reload();
            });
        }

        function deletePrice(id) {
            if (!confirm('确认删除？')) return;
            ajaxPost('/Customer/DeletePrice?id=' + id, {}, function () {
                location.reload();
            });
        }
    </script>
}
