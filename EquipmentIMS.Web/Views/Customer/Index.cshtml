@model PagedResult<EquipmentIMS.Models.DTOs.CustomerDto>
@{
    ViewData["Title"] = "客户管理";
    var keyword = ViewData["Keyword"] as string;
}

<div class="content-card">
    <div class="content-header">
        <h4><i class="bi bi-people me-2"></i>客户管理</h4>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>新增客户</a>
    </div>

    <form class="search-bar" method="get" asp-action="Index">
        <input type="text" name="keyword" class="form-control" placeholder="编码/名称" value="@keyword" />
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>搜索</button>
    </form>

    <div class="table-responsive">
        <table class="table data-table">
            <thead><tr>
                <th>编码</th><th>名称</th><th>联系人</th><th>联系电话</th><th>信用额度</th><th>已用额度</th><th>创建时间</th><th style="width:160px">操作</th>
            </tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.ContactPerson</td>
                        <td>@item.ContactPhone</td>
                        <td>@item.CreditLimit.ToString("N2")</td>
                        <td>@item.UsedCredit.ToString("N2")</td>
                        <td>@item.CreateTime.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a asp-action="Price" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="专属价格"><i class="bi bi-tag"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="编辑"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('确认删除？')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="删除"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{
        ViewData["Page"] = Model.Page;
        ViewData["PageSize"] = Model.PageSize;
        ViewData["TotalCount"] = Model.TotalCount;
        @await Html.PartialAsync("_Pager")
    }
</div>
