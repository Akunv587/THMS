@model PagedResult<EquipmentIMS.Models.DTOs.PurchaseOrderListDto>
@{
    ViewData["Title"] = "采购订单管理";
    var query = ViewData["Query"] as EquipmentIMS.Web.Models.PurchaseOrderQueryViewModel;
}

<div class="content-card">
    <div class="content-header">
        <h4><i class="bi bi-cart-plus me-2"></i>采购订单管理</h4>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>新增采购订单</a>
    </div>

    <form class="search-bar" method="get" asp-action="Index">
        <div class="form-group">
            <label>关键字</label>
            <input type="text" name="Keyword" class="form-control" placeholder="订单号/供应商" value="@query?.Keyword" />
        </div>
        <div class="form-group">
            <label>状态</label>
            <select name="Status" class="form-select">
                <option value="">全部</option>
                <option value="0" selected="@(query?.Status == 0)">草稿</option>
                <option value="1" selected="@(query?.Status == 1)">待审批</option>
                <option value="2" selected="@(query?.Status == 2)">已审批</option>
                <option value="3" selected="@(query?.Status == 3)">部分入库</option>
                <option value="4" selected="@(query?.Status == 4)">已入库</option>
                <option value="5" selected="@(query?.Status == 5)">已关闭</option>
                <option value="6" selected="@(query?.Status == 6)">已取消</option>
            </select>
        </div>
        <div class="form-group">
            <label>开始日期</label>
            <input type="date" name="StartDate" class="form-control" value="@query?.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label>结束日期</label>
            <input type="date" name="EndDate" class="form-control" value="@query?.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>搜索</button>
        <a asp-action="Index" class="btn btn-outline-secondary">重置</a>
    </form>

    <div class="table-responsive mt-3">
        <table class="table data-table">
            <thead><tr>
                <th>订单号</th><th>供应商</th><th>仓库</th><th>订单日期</th><th>金额</th><th>状态</th><th>创建人</th><th style="width:80px">操作</th>
            </tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    var statusClass = item.Status switch
                    {
                        EquipmentIMS.Models.Enums.PurchaseOrderStatus.Draft => "bg-secondary",
                        EquipmentIMS.Models.Enums.PurchaseOrderStatus.PendingApproval => "bg-warning text-dark",
                        EquipmentIMS.Models.Enums.PurchaseOrderStatus.Approved => "bg-info",
                        EquipmentIMS.Models.Enums.PurchaseOrderStatus.PartialReceived => "bg-primary",
                        EquipmentIMS.Models.Enums.PurchaseOrderStatus.Received => "bg-success",
                        EquipmentIMS.Models.Enums.PurchaseOrderStatus.Closed => "bg-dark",
                        EquipmentIMS.Models.Enums.PurchaseOrderStatus.Cancelled => "bg-danger",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@item.Id" class="fw-bold">@item.OrderNo</a></td>
                        <td>@item.SupplierName</td>
                        <td>@item.WarehouseName</td>
                        <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@item.TotalAmount.ToString("N2")</td>
                        <td><span class="badge @statusClass">@item.StatusName</span></td>
                        <td>@item.CreateBy</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="详情"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{
        ViewData["Page"] = Model.Page;
        ViewData["PageSize"] = Model.PageSize;
        ViewData["TotalCount"] = Model.TotalCount;
        @await Html.PartialAsync("_Pager")
    }
</div>
