@model PagedResult<EquipmentIMS.Models.DTOs.PurchaseReturnListDto>
@{
    ViewData["Title"] = "采购退货管理";
    var query = ViewData["Query"] as EquipmentIMS.Web.Models.PurchaseReturnQueryViewModel;
}

<div class="content-card">
    <div class="content-header">
        <h4><i class="bi bi-arrow-return-left me-2"></i>采购退货管理</h4>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>新增退货</a>
    </div>

    <form class="search-bar" method="get" asp-action="Index">
        <div class="form-group">
            <label>关键字</label>
            <input type="text" name="Keyword" class="form-control" placeholder="退货单号/入库单号/供应商" value="@query?.Keyword" />
        </div>
        <div class="form-group">
            <label>开始日期</label>
            <input type="date" name="StartDate" class="form-control" value="@query?.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label>结束日期</label>
            <input type="date" name="EndDate" class="form-control" value="@query?.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>搜索</button>
        <a asp-action="Index" class="btn btn-outline-secondary">重置</a>
    </form>

    <div class="table-responsive mt-3">
        <table class="table data-table">
            <thead><tr>
                <th>退货单号</th><th>入库单号</th><th>供应商</th><th>仓库</th><th>退货日期</th><th>金额</th><th>退货原因</th><th>操作人</th>
            </tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><strong>@item.ReturnNo</strong></td>
                        <td>@item.InNo</td>
                        <td>@item.SupplierName</td>
                        <td>@item.WarehouseName</td>
                        <td>@item.ReturnDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@item.TotalAmount.ToString("N2")</td>
                        <td>@item.Reason</td>
                        <td>@item.Operator</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{
        ViewData["Page"] = Model.Page;
        ViewData["PageSize"] = Model.PageSize;
        ViewData["TotalCount"] = Model.TotalCount;
        @await Html.PartialAsync("_Pager")
    }
</div>
