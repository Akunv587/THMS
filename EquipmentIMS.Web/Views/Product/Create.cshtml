@model EquipmentIMS.Web.Models.ProductViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "编辑设备" : "新增设备";
}

<div class="content-card" style="max-width:720px">
    <div class="content-header">
        <h4>@ViewData["Title"]</h4>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>返回</a>
    </div>

    <form asp-action="@(Model.Id > 0 ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">请选择分类</option>
                    @{
                        var cats2 = ViewBag.Categories as List<EquipmentIMS.Models.DTOs.CategoryTreeDto>;
                        if (cats2 != null) { await RenderCatOptions(cats2, 0, Model.CategoryId); }
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Spec" class="form-label"></label>
                <input asp-for="Spec" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Unit" class="form-label"></label>
                <input asp-for="Unit" class="form-control" placeholder="台/件/套" />
            </div>
            <div class="col-md-3">
                <label asp-for="BarCode" class="form-label"></label>
                <input asp-for="BarCode" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="PurchasePrice" class="form-label"></label>
                <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SalePrice" class="form-label"></label>
                <input asp-for="SalePrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="SalePrice" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MinStock" class="form-label"></label>
                <input asp-for="MinStock" class="form-control" type="number" min="0" />
                <span asp-validation-for="MinStock" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Remark" class="form-label"></label>
                <textarea asp-for="Remark" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>保存</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">取消</a>
        </div>
    </form>
</div>

@functions {
    async Task RenderCatOptions(List<EquipmentIMS.Models.DTOs.CategoryTreeDto> nodes, int depth, long selectedId)
    {
        foreach (var n in nodes)
        {
            var prefix = depth > 0 ? new string(' ', depth * 2) + "┗ " : "";
            var sel = n.Id == selectedId;
            if (sel)
            {
                <option value="@n.Id" selected="selected">@prefix@n.Name</option>
            }
            else
            {
                <option value="@n.Id">@prefix@n.Name</option>
            }
            if (n.Children.Any()) { await RenderCatOptions(n.Children, depth + 1, selectedId); }
        }
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
