@model PagedResult<EquipmentIMS.Models.DTOs.WarehouseDto>
@{
    ViewData["Title"] = "仓库管理";
    var keyword = ViewData["Keyword"] as string;
}

<div class="content-card">
    <div class="content-header">
        <h4><i class="bi bi-building me-2"></i>仓库管理</h4>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>新增仓库</a>
    </div>

    <form class="search-bar" method="get" asp-action="Index">
        <input type="text" name="keyword" class="form-control" placeholder="编码/名称" value="@keyword" />
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search me-1"></i>搜索</button>
    </form>

    <div class="table-responsive mt-3">
        <table class="table data-table">
            <thead><tr>
                <th>编码</th><th>名称</th><th>地址</th><th>负责人</th><th>联系电话</th><th>默认仓库</th><th>创建时间</th><th style="width:140px">操作</th>
            </tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.Address</td>
                        <td>@item.Manager</td>
                        <td>@item.Phone</td>
                        <td>
                            @if (item.IsDefault)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>默认</span>
                            }
                        </td>
                        <td>@item.CreateTime.ToString("yyyy-MM-dd")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="编辑"><i class="bi bi-pencil"></i></a>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteWarehouse(@item.Id)" title="删除"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @{
        ViewData["Page"] = Model.Page;
        ViewData["PageSize"] = Model.PageSize;
        ViewData["TotalCount"] = Model.TotalCount;
        @await Html.PartialAsync("_Pager")
    }
</div>

@section Scripts {
    <script>
        function deleteWarehouse(id) {
            if (!confirm('确认删除该仓库？')) return;
            ajaxPost('/Warehouse/Delete', { id: id }, function (res) {
                location.reload();
            });
        }
    </script>
}
