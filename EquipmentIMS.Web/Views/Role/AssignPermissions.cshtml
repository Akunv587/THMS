@model EquipmentIMS.Models.DTOs.AssignPermissionsDto
@{
    ViewData["Title"] = "分配权限";
}

@functions {
    void RenderTree(List<EquipmentIMS.Models.DTOs.PermissionTreeDto> nodes, int level)
    {
        foreach (var node in nodes)
        {
            var typeBadge = node.PermissionType == 1 ? "bg-primary" : node.PermissionType == 2 ? "bg-info" : "bg-warning";
            <div class="ms-@(level * 3) mb-1">
                <div class="form-check">
                    <input type="checkbox" name="permissionIds" value="@node.Id" class="form-check-input permission-check" id="perm_@node.Id"
                           data-parent="@node.ParentId" @(node.IsChecked ? "checked" : "") />
                    <label class="form-check-label" for="perm_@node.Id">
                        <span class="badge @typeBadge me-1" style="font-size:0.7em">@node.PermissionTypeName</span>
                        @node.PermissionName
                        <small class="text-muted"><code>@node.PermissionCode</code></small>
                    </label>
                </div>
            </div>
            if (node.Children.Count > 0)
            {
                RenderTree(node.Children, level + 1);
            }
        }
    }
}

<div class="content-card">
    <div class="content-header">
        <h4><i class="bi bi-lock me-2"></i>分配权限 - @Model.RoleName (@Model.RoleCode)</h4>
        <div>
            <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="checkAll()">全选</button>
            <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="uncheckAll()">全不选</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>返回</a>
        </div>
    </div>

    <form asp-action="AssignPermissions" asp-route-id="@Model.RoleId" method="post" id="permForm">
        @Html.AntiForgeryToken()

        <div class="border rounded p-3" style="max-height:60vh;overflow-y:auto">
            @if (!Model.PermissionTree.Any())
            {
                <p class="text-muted">暂无可分配的权限</p>
            }
            else
            {
                RenderTree(Model.PermissionTree, 0);
            }
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>保存权限</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function checkAll() { document.querySelectorAll('.permission-check').forEach(c => c.checked = true); }
        function uncheckAll() { document.querySelectorAll('.permission-check').forEach(c => c.checked = false); }
    </script>
}
