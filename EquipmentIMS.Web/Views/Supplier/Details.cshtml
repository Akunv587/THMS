@model EquipmentIMS.Models.DTOs.SupplierDto
@{
    ViewData["Title"] = "供应商详情";
}

<div class="content-card" style="max-width:720px">
    <div class="content-header">
        <h4>@ViewData["Title"]</h4>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>返回</a>
    </div>

    <table class="table table-bordered">
        <tr><td class="bg-light fw-bold" style="width:120px">编码</td><td>@Model.Code</td></tr>
        <tr><td class="bg-light fw-bold">名称</td><td>@Model.Name</td></tr>
        <tr><td class="bg-light fw-bold">联系人</td><td>@Model.ContactPerson</td></tr>
        <tr><td class="bg-light fw-bold">联系电话</td><td>@Model.ContactPhone</td></tr>
        <tr><td class="bg-light fw-bold">邮箱</td><td>@Model.Email</td></tr>
        <tr><td class="bg-light fw-bold">地址</td><td>@Model.Address</td></tr>
        <tr><td class="bg-light fw-bold">开户行</td><td>@Model.BankName</td></tr>
        <tr><td class="bg-light fw-bold">银行账号</td><td>@Model.BankAccountMasked</td></tr>
        <tr><td class="bg-light fw-bold">备注</td><td>@Model.Remark</td></tr>
        <tr><td class="bg-light fw-bold">创建时间</td><td>@Model.CreateTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
    </table>
</div>
